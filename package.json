{
  "name": "reloop",
  "private": true,
  "version": "0.1.0",
  "description": "RE-LOOP - second-hand fashion marketplace (microservices monorepo)",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "backend/shared",
    "backend/gateway",
    "backend/services/*",
    "frontend"
  ],
  "scripts": {
    "dev": "docker compose up --build",
    "down": "docker compose down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "node scripts/ensurePrismaClients.js --force",
    "pretest": "node scripts/ensurePrismaClients.js && node -e \"require('fs').mkdirSync('coverage',{recursive:true})\"",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"backend/**/*.test.js\" \"scripts/*.test.js\"",
    "test:frontend": "npm --workspace frontend run test",
    "secret-scan": "node scripts/secretScan.js",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2"
  }
}
