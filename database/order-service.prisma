datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Custom output path — see the comment in product-service/prisma/schema.prisma:
// this npm workspace hoists @prisma/client to one shared location, so every
// service that generates a client there fights over the same physical folder.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

// Status lifecycle: pending_payment (cart, product locked) -> completed (paid), or cancelled (product unlocked).
// confirmed/shipped are reserved for a future fulfillment flow and are not driven by the UI yet.
// disputed/refunded added for CSS-003 (WF-08): completed -> disputed -> refunded | completed.
// Two roles touch a dispute and they share one payout-hold flag (`payoutHeld`):
//   - CS owns the *case* (DisputeCase below) — buyer opens it, an agent decides it.
//   - Admin owns the *fund hold* escalation (ADM-004) via adminDisputeService,
//     not the buyer/seller updateStatus endpoint. preDisputeStatus remembers
//     what `status` was so a release can restore it.
// paymentSimulationStatus stays Admin's own state machine, but both sides read
// and write payoutHeld so there is never a second source of truth for
// "is this seller's money frozen right now".
model Order {
  id                   String    @id @default(uuid())
  buyerId              String    @map("buyer_id")
  sellerId             String    @map("seller_id")
  productId            String    @map("product_id")
  productTitle         String    @map("product_title")
  price                Int
  status               String    @default("pending_payment")
  reservationId        String?   @unique @map("reservation_id")
  reservationExpiresAt DateTime? @map("reservation_expires_at")
  auctionId            String?   @map("auction_id")
  payoutHeld           Boolean   @default(false) @map("payout_held")
  disputedAt           DateTime? @map("disputed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  paymentSimulationStatus String    @default("RELEASE_PENDING") @map("payment_simulation_status")
  version                 Int       @default(1)
  holdReason              String?   @map("hold_reason")
  heldAt                  DateTime? @map("held_at")
  heldBy                  String?   @map("held_by")
  preDisputeStatus        String?   @map("pre_dispute_status")

  dispute           DisputeCase?
  adminEvidence     AdminDisputeEvidence[]
  holds             OrderHold[]
  productSyncEvents ProductSyncEvent[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([auctionId])
  @@index([status, reservationExpiresAt])
  @@map("orders")
}

// TSR-02: Decoupled active hold sources per order (Dispute, T&S Hold, Account Sanction).
model OrderHold {
  id            String    @id @default(uuid())
  orderId       String    @map("order_id")
  source        String // DISPUTE | TRUST_AND_SAFETY | ACCOUNT_SANCTION
  referenceId   String?   @map("reference_id")
  reason        String
  heldBy        String    @map("held_by")
  heldAt        DateTime  @default(now()) @map("held_at")
  releasedAt    DateTime? @map("released_at")
  releasedBy    String?   @map("released_by")
  releaseReason String?   @map("release_reason")
  // Populated only by the legacy backfill. PostgreSQL permits multiple NULLs,
  // while a non-null key makes concurrent backfill executions idempotent.
  dedupeKey     String?   @unique @map("dedupe_key")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, releasedAt])
  @@map("order_holds")
}

// Transactional outbox for cross-service product state changes. The Order
// transition and this event are committed together; a retry worker delivers
// pending events until product-service acknowledges them.
model ProductSyncEvent {
  id            String    @id @default(uuid())
  orderId       String    @map("order_id")
  dedupeKey     String    @unique @map("dedupe_key")
  action        String // COMPLETE_RESERVATION | RELEASE_RESERVATION | SET_STATUS
  productId     String    @map("product_id")
  reservationId String?   @map("reservation_id")
  targetStatus  String?   @map("target_status")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([processedAt, nextAttemptAt])
  @@index([orderId, processedAt])
  @@map("product_sync_events")
}

model AdminDisputeEvidence {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id])
  evidenceRef String   @map("evidence_ref")
  note        String?
  submittedBy String   @map("submitted_by")
  submittedAt DateTime @default(now()) @map("submitted_at")

  @@index([orderId])
  @@map("admin_dispute_evidence")
}

model DisputeAudit {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  actorId   String   @map("actor_id")
  action    String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("dispute_audits")
}

model DisputeCase {
  id               String    @id @default(uuid())
  orderId          String    @unique @map("order_id")
  openedBy         String    @map("opened_by")
  reason           String
  status           String    @default("OPEN")
  decision         String?
  decisionReason   String?   @map("decision_reason")
  decidedBy        String?   @map("decided_by")
  decidedAt        DateTime? @map("decided_at")
  evidenceDeadline DateTime? @map("evidence_deadline")
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")

  assignedTo   String?   @map("assigned_to")
  assignedRole String?   @map("assigned_role")
  claimedAt    DateTime? @map("claimed_at")

  order    Order             @relation(fields: [orderId], references: [id])
  evidence DisputeEvidence[]
  auditLog DisputeAuditLog[]

  @@map("dispute_cases")
}

model DisputeAuditLog {
  id        String   @id @default(uuid())
  disputeId String   @map("dispute_id")
  actorId   String   @map("actor_id")
  action    String
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  dispute DisputeCase @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
  @@map("dispute_audit_logs")
}

model DisputeEvidence {
  id         String   @id @default(uuid())
  disputeId  String   @map("dispute_id")
  uploaderId String   @map("uploader_id")
  storageKey String   @map("storage_key")
  fileType   String   @map("file_type")
  createdAt  DateTime @default(now()) @map("created_at")

  dispute DisputeCase @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_evidence")
}
