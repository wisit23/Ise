// pg_trgm powers the search_text GIN index below (trigram matching works on
// Thai text, unlike Postgres full-text search, which has no Thai word-break
// config — see productModel.js search() for why).
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// Custom output path: this is an npm workspace monorepo where @prisma/client
// hoists to a single shared node_modules — without this, generating this
// service's client would silently overwrite every other service's client
// (they'd all fight over the same physical folder). Docker builds each
// service in isolation so they wouldn't collide there, but local `npm test`
// runs every service's tests in one process and needs them to coexist.
generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

// Canonical ER: database/erdesign/Product Service/ข้อ1 plus approved amendments.
// category retains the legacy primary display value; membership is product_categories.
// condition references the existing unique lookup value without adding an ER column.
// Status lifecycle: available -> reserved (in a buyer's cart) -> sold, or removed by the seller.
model RecommendationSearch {
  userId String @map("user_id")
  query String
  searchedAt DateTime @default(now()) @map("searched_at")

  @@id([userId, query])
  @@index([userId, searchedAt])
  @@map("recommendation_searches")
}

model Product {
  id                   String                   @id @default(uuid())
  sellerId             String                   @map("seller_id")
  title                String
  description          String                   @default("")
  price                Int
  category             String
  brand                String                   @default("")
  searchVector         Unsupported("tsvector")? @map("search_vector")
  condition            String                   @default("Good")
  tags                 String[]
  location             String                   @default("")
  size                 String                   @default("Free size")
  status               String                   @default("available")
  // BUY-xxx: a cart reservation holds the listing for 10 minutes; the expiry
  // worker in features/reservations releases it when the clock runs out.
  reservationId        String?                  @unique @map("reservation_id")
  reservedBy           String?                  @map("reserved_by")
  reservationExpiresAt DateTime?                @map("reservation_expires_at")
  // ADM-003 / TSR-04: moderatedAt is the independent publication/purchase
  // overlay. Commerce `status` may continue from reserved -> available/sold
  // while moderated without making the listing public again. preRemovalStatus
  // is retained as historical/legacy restore context, never as the sole source
  // of truth for the current commerce state.
  moderatedAt          DateTime?                @map("moderated_at")
  moderationReason     String?                  @map("moderation_reason")
  preRemovalStatus     String?                  @map("pre_removal_status")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  // Denormalized concat of title/description/category/brand/condition/location/
  // size/tags, kept in sync by a DB trigger (see prisma/seed.js — Postgres
  // can't use a native generated column here because array_to_string() is
  // STABLE, not IMMUTABLE). This is the one field search() matches against.
  searchText String @default("") @map("search_text")

  photos             Photo[]
  videos             Video[]
  reviewClips        ProductVideo[]
  auctions           AuctionItem[]
  categoryLinks      ProductCategory[]
  countViews         CountView[]
  conditionDefinition Condition @relation(fields: [condition], references: [value])

  @@index([sellerId])
  @@index([status, category])
  @@index([searchVector], type: Gin, map: "products_search_vector_idx")
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([status, reservationExpiresAt])
  @@map("products")
}

// Approved M:N amendment, with no surrogate key or extra columns.
model ProductCategory {
  productId String @map("product_id")
  categoryId String @map("category_id")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

// ER: Photo { Photo_ID, URL, Product_ID }
// position is not in the ER — added so the seller's chosen order/cover image
// (index 0) survives being split across two separate photos/videos tables.
model Photo {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("photos")
}

// ER: Video { Video_ID, Caption, CreatedAt, URL, Product_ID }
model Video {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  caption   String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("videos")
}

// ER setup table.
model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  products ProductCategory[]

  @@map("categories")
}

// ER setup table: one condition per product.
model Condition {
  id        String @id @default(uuid())
  value     String @unique
  label     String
  sortOrder Int    @default(0) @map("sort_order")

  products Product[]

  @@map("conditions")
}

// Not in the ER (closest is the "Swipe" entity, repurposed here) — a short
// review clip a seller attaches to one of their listings, for the swipe
// ("ปัดดูสินค้า") feed. Deliberately separate from `Video` above: `Video` is
// gallery media on the product detail page (ordered, no seller identity of
// its own), this is a standalone feed item with its own caption and a
// denormalized seller name so the feed doesn't need to join out per card.
model ProductVideo {
  id          String   @id @default(uuid())
  videoUrl    String
  description String?
  sellerId    String   @map("seller_id")
  sellerName  String?  @map("seller_name")
  productId   String   @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  choices SwipeChoice[]

  @@index([productId])
  @@index([sellerId])
  @@index([createdAt])
  @@map("product_videos")
}

// UR-11 "Swipe-to-Choose": a buyer marking one swipe card as interesting.
// Deliberately separate from Bid below — choosing a card just bookmarks it
// for later, it is not itself a bid and does not require an open auction.
model SwipeChoice {
  id             String   @id @default(uuid())
  productVideoId String   @map("product_video_id")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  productVideo ProductVideo @relation(fields: [productVideoId], references: [id], onDelete: Cascade)

  // One choice per user per card — swiping again just confirms, doesn't duplicate.
  @@unique([productVideoId, userId])
  @@index([userId])
  @@map("swipe_choices")
}

// Not in the original ER — Marketing (MKT-005) requirement, Seller/Product
// owned. One Product goes through at most one auction at a time; Marketing
// schedules it, Admin approves it, Seller sets the starting price/increment,
// Buyers bid.
enum AuctionStatus {
  draft
  pending_approval
  rejected
  approved
  scheduled
  open
  closed
  cancelled
}

model AuctionItem {
  id               String        @id @default(uuid())
  productId        String        @map("product_id")
  sellerId         String        @map("seller_id")
  status           AuctionStatus @default(draft)
  // Seller-owned pricing (see MKT/marketing decision log: Seller sets these,
  // not Marketing — Marketing only controls the schedule).
  startingPrice    Int           @map("starting_price")
  bidIncrement     Int           @map("bid_increment")
  // Marketing-owned schedule.
  scheduledStartAt DateTime?     @map("scheduled_start_at")
  scheduledEndAt   DateTime?     @map("scheduled_end_at")
  openedAt         DateTime?     @map("opened_at")
  closedAt         DateTime?     @map("closed_at")
  approvedBy       String?       @map("approved_by")
  approvedAt       DateTime?     @map("approved_at")
  winningBidId     String?       @unique @map("winning_bid_id")
  // Order created in order-service once the auction closes with a winner —
  // read via provider contract, never a cross-service DB read.
  winningOrderId   String?       @map("winning_order_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  roundId String?       @map("round_id")
  round   AuctionRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  bids    Bid[]         @relation("AuctionBids")

  @@index([productId])
  @@index([sellerId])
  @@index([status])
  @@index([roundId])
  @@map("auction_items")
}

model AuctionRound {
  id                 String   @id @default(uuid())
  submissionStartsAt DateTime @map("submission_starts_at")
  submissionEndsAt   DateTime @map("submission_ends_at")
  auctionStartsAt    DateTime @map("auction_starts_at")
  auctionEndsAt      DateTime @map("auction_ends_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  auctions AuctionItem[]

  @@map("auction_rounds")
}

model Bid {
  id             String   @id @default(uuid())
  auctionId      String   @map("auction_id")
  bidderId       String   @map("bidder_id")
  amount         Int
  // Client-supplied key so a retried request never creates a second bid.
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  auction AuctionItem @relation("AuctionBids", fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, amount])
  @@index([bidderId])
  @@map("bids")
}

// Marketing Content & Community Articles (ST-MKT-05 / UR-14 / FR-5.2.3)
model Article {
  id          String        @id @default(uuid())
  title       String
  slug        String?       @unique
  summary     String?       @db.Text
  content     String        @db.Text
  coverImage  String?       @map("cover_image")
  category    String        @default("general")
  status      ArticleStatus @default(draft)
  authorId    String        @map("author_id")
  authorName  String?       @map("author_name")
  searchText  String        @default("") @map("search_text")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([category])
  @@index([status, category])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("articles")
}

enum ArticleStatus {
  draft
  published
  archived
}

// Marketing Campaign Domain (MKT-001 / UR-15 / UR-16 / WF-11)
enum CampaignStatus {
  draft
  pending_approval
  approved
  published
  ended
  rejected
}

enum DiscountType {
  PERCENT
  FIXED
}

enum VoucherStatus {
  CLAIMED
  USED
  EXPIRED
}

model Campaign {
  id                 String         @id @default(uuid())
  code               String         @unique
  name               String
  description        String?        @db.Text
  discountType       DiscountType   @default(PERCENT) @map("discount_type")
  discountValue      Int            @map("discount_value")
  minOrderPrice      Int            @default(0) @map("min_order_price")
  maxDiscount        Int?           @map("max_discount")
  applicableCategory String?        @map("applicable_category")
  budget             Int?
  usageLimit         Int?           @map("usage_limit")
  usedCount          Int            @default(0) @map("used_count")
  status             CampaignStatus @default(draft)
  startsAt           DateTime       @map("starts_at")
  endsAt             DateTime       @map("ends_at")
  createdById        String         @map("created_by_id")
  approvedById       String?        @map("approved_by_id")
  approvedAt         DateTime?      @map("approved_at")
  version            Int            @default(1)
  targetSegment      Json?          @map("target_segment")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  vouchers UserVoucher[]

  @@index([status])
  @@index([code])
  @@index([startsAt, endsAt])
  @@map("campaigns")
}

// Buyer Voucher Wallet (Claimed vouchers per user)
model UserVoucher {
  id          String        @id @default(uuid())
  campaignId  String        @map("campaign_id")
  userId      String        @map("user_id")
  status      VoucherStatus @default(CLAIMED)
  claimedAt   DateTime      @default(now()) @map("claimed_at")
  usedAt      DateTime?     @map("used_at")
  usedOrderId String?       @map("used_order_id")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@map("user_vouchers")
}

// One row per viewer/product pair; viewerId is a logical Auth-service reference.
model CountView {
  viewerId String  @map("viewer_id")
  productId String @map("product_id")
  count Int @default(1)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([viewerId, productId])
  @@map("count_views")
}

// Seller reviews are stored with product-service. The buyer and completed
// order are verified through order-service's internal API before creation.
// Approved logical product reference: keep the purchased ID after product deletion.
model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique @map("order_id")
  buyerId   String   @map("buyer_id")
  sellerId  String   @map("seller_id")
  productId String?  @map("product_id")
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  mediaEntries ReviewMedia[]

  @@index([sellerId])
  @@index([productId])
  @@map("reviews")
}

enum ReviewMediaType {
  IMAGE
  VIDEO
}

model ReviewMedia {
  id        String          @id @default(uuid()) @map("media_id")
  reviewId  String          @map("review_id")
  mediaType ReviewMediaType @map("media_type")
  url       String
  position  Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_media")
}

// Marketing Campaign Attribution Facts (MKT-003 / MKT-007 / UR-09 / UR-12)
// Persisted immutable record of an order completed with an applied campaign voucher.
// Idempotency: eventId is primary key; orderId is unique.
model CampaignAttribution {
  eventId        String   @id @map("event_id")
  orderId        String   @unique @map("order_id")
  campaignId     String   @map("campaign_id")
  grossAmount    Decimal      @map("gross_amount") @db.Decimal(12, 2)
  discountAmount Decimal      @map("discount_amount") @db.Decimal(12, 2)
  netAmount      Decimal      @map("net_amount") @db.Decimal(12, 2)
  completedAt    DateTime @map("completed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([campaignId])
  @@index([completedAt])
  @@map("campaign_attributions")
}

// Marketing Audit Log (append-only audit trail for Marketing operations)
model MarketingAuditLog {
  id             String   @id @default(uuid())
  actorId        String   @map("actor_id")
  actorRole      String   @map("actor_role")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  previousState  Json?    @map("previous_state")
  newState       Json?    @map("new_state")
  metadata       Json?
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([actorId])
  @@map("marketing_audit_logs")
}
