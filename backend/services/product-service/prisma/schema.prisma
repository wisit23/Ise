// pg_trgm powers the search_text GIN index below (trigram matching works on
// Thai text, unlike Postgres full-text search, which has no Thai word-break
// config — see productModel.js search() for why).
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// Custom output path: this is an npm workspace monorepo where @prisma/client
// hoists to a single shared node_modules — without this, generating this
// service's client would silently overwrite every other service's client
// (they'd all fight over the same physical folder). Docker builds each
// service in isolation so they wouldn't collide there, but local `npm test`
// runs every service's tests in one process and needs them to coexist.
generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma-client"
  previewFeatures = ["postgresqlExtensions"]
}

// ER: ties to docs/erdatabase.png's Product entity (Photo/Video are separate
// entities there too). Deviations from the original ER, documented per the
// project's "no ER table is cut, extensions are logged" rule:
//   - condition: not in the ER at all; new column, validated against the
//     `conditions` lookup table below instead of a Prisma enum (avoids
//     "Like New" not being a valid enum identifier).
//   - categories: the ER's Product has no Category entity (just a free
//     "Type" attribute) — added as its own table so the list of categories
//     is real data instead of hardcoded in frontend code. Product.category
//     stays a denormalized string column (not a hard FK) so free-text entry
//     from the seller still works; unseen names are inserted into
//     `categories` on the fly (see productModel.ensureCategory).
//   - tags: not in the ER; kept as a plain string array (no separate join
//     table — tags here are freeform, not a curated taxonomy).
// Status lifecycle: available -> reserved (in a buyer's cart) -> sold, or removed by the seller.
model Product {
  id                   String    @id @default(uuid())
  sellerId             String    @map("seller_id")
  title                String
  description          String    @default("")
  price                Int
  category             String
  condition            String    @default("Good")
  tags                 String[]
  location             String    @default("")
  size                 String    @default("Free size")
  status               String    @default("available")
  reservedBy           String?   @map("reserved_by")
  reservationId        String?   @unique @map("reservation_id")
  reservationExpiresAt DateTime? @map("reservation_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Denormalized concat of title/description/category/condition/location/
  // size/tags, kept in sync by a DB trigger (see prisma/seed.js — Postgres
  // can't use a native generated column here because array_to_string() is
  // STABLE, not IMMUTABLE). This is the one field search() matches against.
  searchText String @default("") @map("search_text")

  // Weighted PostgreSQL full-text document maintained by the same trigger as
  // search_text. `simple` preserves product names/brands without stemming;
  // pg_trgm remains the fallback for Thai substrings and misspellings.
  searchVector Unsupported("tsvector")? @map("search_vector")

  photos      Photo[]
  videos      Video[]
  reviewClips ProductVideo[]

  @@index([sellerId])
  @@index([status, category])
  @@index([status, reservationExpiresAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([searchVector], type: Gin)
  @@map("products")
}

// ER: Photo { Photo_ID, URL, Product_ID }
// position is not in the ER — added so the seller's chosen order/cover image
// (index 0) survives being split across two separate photos/videos tables.
model Photo {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("photos")
}

// ER: Video { Video_ID, Caption, CreatedAt, URL, Product_ID }
model Video {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  caption   String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("videos")
}

// Not in the ER — see the note above the Product model. Source of truth for
// category names; replaces the array that used to be hardcoded in the
// frontend (frontend/lib/constants.js).
model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}

// Not in the ER — lookup table for the condition values validated in
// productController (was a hardcoded array there and in the frontend).
model Condition {
  id        String @id @default(uuid())
  value     String @unique
  label     String
  sortOrder Int    @default(0) @map("sort_order")

  @@map("conditions")
}

// Not in the ER (closest is the "Swipe" entity, repurposed here) — a short
// review clip a seller attaches to one of their listings, for the swipe
// ("ปัดดูสินค้า") feed. Deliberately separate from `Video` above: `Video` is
// gallery media on the product detail page (ordered, no seller identity of
// its own), this is a standalone feed item with its own caption and a
// denormalized seller name so the feed doesn't need to join out per card.
model ProductVideo {
  id          String   @id @default(uuid())
  videoUrl    String
  description String?
  sellerId    String   @map("seller_id")
  sellerName  String?  @map("seller_name")
  productId   String   @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sellerId])
  @@index([createdAt])
  @@map("product_videos")
}
