tion" target="chat-E_Message" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="1340"/><mxPoint x="1180" y="1300"/></Array></mxGeometry></mxCell><mxCell id="chat-e19-m0" value="1" style="edgeLabel;html=1;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" vertex="1" connectable="0" parent="chat-e19"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="12" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="chat-e19-m1" value="*" style="edgeLabel;html=1;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" vertex="1" connectable="0" parent="chat-e19"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-12" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="chat-e20" value="ไฟล์แนบ" style="html=1;rounded=0;jumpStyle=arc;jumpSize=8;fontSize=11;fontColor=#000000;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;strokeColor=#000000;exitX=0.48;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" source="chat-E_Message" target="chat-E_Attachment" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="1620"/><mxPoint x="1540" y="1620"/></Array></mxGeometry></mxCell><mxCell id="chat-e20-m0" value="1" style="edgeLabel;html=1;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" vertex="1" connectable="0" parent="chat-e20"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="10" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="chat-e20-m1" value="0..1" style="edgeLabel;html=1;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" vertex="1" connectable="0" parent="chat-e20"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="10" y="-12" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Support Service (Customer Service)" id="support"><mxGraphModel adaptiveColors="none" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="support-title" value="Support Service (Customer Service) – Class Diagram (ออกแบบแบบ OOP)" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1600" height="34" as="geometry"/></mxCell><mxCell id="support-legend" value="รูปนี้คือการออกแบบแบบ OOP: domain class มีทั้งข้อมูลและ method · Service/Manager ทำงานสร้าง ค้นหา ดึงรายการ&lt;br&gt;ตอนเขียนโค้ดจริง (Prisma): ข้อมูลของ domain class อยู่ใน schema.prisma ส่วน method อยู่ในไฟล์ service — ดูตาราง design-to-code-mapping.md&lt;br&gt;เส้นทึบ + ตัวเลข = ความสัมพันธ์ (multiplicity) · ◆ = ส่วนประกอบที่ฝังอยู่ข้างใน · เส้นประ ---&amp;gt; = เรียกใช้ / จัดการ&lt;br&gt;ข้อมูลของ domain class เก็บใน PostgreSQL ผ่าน Prisma (schema.prisma)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="300" y="84" width="1600" height="82" as="geometry"/></mxCell><mxCell id="support-L0" value="Service / Manager" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="support-L4" value="Domain classes" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="220" height="60" as="geometry"/></mxCell><mxCell id="support-cont" value="Domain classes" style="rounded=0;html=1;dashed=1;fillColor=#FBFEFB;strokeColor=#6A9F6A;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2F6B2F;" vertex="1" parent="1"><mxGeometry x="240" y="1060" width="2280" height="1660" as="geometry"/></mxCell><mxCell id="support-features_tickets_ticketService_js" value="&lt;b&gt;TicketService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;&lt;/font