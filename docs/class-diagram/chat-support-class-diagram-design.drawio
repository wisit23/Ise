<mxfile host="app.diagrams.net"><diagram name="Chat Service" id="chat"><mxGraphModel adaptiveColors="none" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="chat-title" value="Chat Service – Class Diagram (ออกแบบแบบ OOP)" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1600" height="34" as="geometry"/></mxCell><mxCell id="chat-legend" value="รูปนี้คือการออกแบบแบบ OOP: domain class มีทั้งข้อมูลและ method · Service/Manager ทำงานสร้าง ค้นหา ดึงรายการ&lt;br&gt;ตอนเขียนโค้ดจริง (Prisma): ข้อมูลของ domain class อยู่ใน schema.prisma ส่วน method อยู่ในไฟล์ service — ดูตาราง design-to-code-mapping.md&lt;br&gt;เส้นทึบ + ตัวเลข = ความสัมพันธ์ (multiplicity) · ◆ = ส่วนประกอบที่ฝังอยู่ข้างใน · เส้นประ ---&amp;gt; = เรียกใช้ / จัดการ&lt;br&gt;ข้อมูลของ domain class เก็บใน MongoDB ผ่าน Prisma (schema.prisma)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="300" y="84" width="1600" height="82" as="geometry"/></mxCell><mxCell id="chat-L0" value="Service / Manager" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="chat-L4" value="Domain classes" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="220" height="60" as="geometry"/></mxCell><mxCell id="chat-cont" value="Domain classes" style="rounded=0;html=1;dashed=1;fillColor=#FBFEFB;strokeColor=#6A9F6A;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2F6B2F;" vertex="1" parent="1"><mxGeometry x="740" y="1070" width="1250" height="820" as="geometry"/></mxCell><mxCell id="chat-features_conversations_conversationService_js"