<mxfile host="app.diagrams.net"><diagram name="Chat Service" id="chat"><mxGraphModel adaptiveColors="none" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="chat-title" value="Chat Service – Class Diagram (ตรงกับโค้ดจริง)" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1600" height="34" as="geometry"/></mxCell><mxCell id="chat-legend" value="กล่อง 1 กล่อง = 1 ไฟล์ .js (JS ไม่มี class: เป็น module ที่ export ฟังก์ชัน) หรือ 1 model ใน schema.prisma  ·  ใต้ชื่อ = ไฟล์ที่อยู่จริง&lt;br&gt;+ ชื่อ(...) = ฟังก์ชัน/ค่าที่ export  ·  ← METHOD /path = endpoint ที่เรียกฟังก์ชันนี้  ·  - prisma → X = ไฟล์นี้อ่าน/เขียน model X ผ่าน PrismaClient&lt;br&gt;เส้นประเทา ---&amp;gt; = A require B (เรียกฟังก์ชันของ B)  ·  เส้นทึบ + ตัวเลข = ความสัมพันธ์ใน Prisma (FK)  ·  ◆ = ฝังอยู่ใน document  ·  เส้นประน้ำเงิน = HTTP ข้าม service&lt;br&gt;endpoint ทั่วไปผ่าน requireAuth, /internal ผ่าน requireInternalToken (@reloop/shared)  ·  ตัด app.js, server.js, *Routes.js และ prismaClient.js ออก เพราะเป็นแค่ไฟล์ต่อสาย&lt;br&gt;Database: MongoDB (Prisma provider = mongodb)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="300" y="84" width="1600" height="100" as="geometry"/></mxCell><mxCell id="chat-L0" value="Controller / Handler  (รับ request)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="chat-L1" value="Service  (ตรรกะ)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="220" height="60" as="geometry"/></mxCell><mxCell id="chat-L2" value="Model / Helper" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="220" height="60" as="geometry"/></mxCell><mxCell id="chat-L3" value="Client · Realtime · Infra" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1810" width="220" height="60" as="geometry"/></mxCell><mxCell id="chat-L4" value="Prisma  (schema.prisma)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="2520" width="220" height="60" as="geometry"/></mxCell><mxCell id="chat-cont" value="PrismaClient  →  schema.prisma" style="rounded=0;html=1;dashed=1;fillColor=#FBFEFB;strokeColor=#6A9F6A;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2F6B2F;" vertex="1" parent="1"><mxGeometry x="3480" y="2520" width="1360" height="800" as="geometry"/></mxCell><mxCell id="chat-features_attachments_attachmentController_js" value="&lt;b&gt;AttachmentController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;src/features/attachments/attachmentController.js&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=13;strokeWidth=1.2;fillColor=#F1ECFB;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2460" y="300" width="440" height="170" as="geometry"/></mxCell><mxCell id="chat-features_attachments_attachmentController_js-a" value="- ใช้ → Broadcast" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#000000;f