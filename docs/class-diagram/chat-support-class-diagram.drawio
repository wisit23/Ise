pSize=8;fontSize=11;fontColor=#000000;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 3;endArrow=open;endSize=9;endFill=0;strokeColor=#1F5FBF;strokeWidth=1.5;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" source="chat-X_support_service" target="chat-features_internal_supportMessages_js" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="8580" y="1720"/><mxPoint x="6200" y="1720"/></Array></mxGeometry></mxCell><mxCell id="chat-e28" value="" style="html=1;rounded=0;jumpStyle=arc;jumpSize=8;fontSize=11;fontColor=#000000;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 3;endArrow=open;endSize=9;endFill=0;strokeColor=#1F5FBF;strokeWidth=1.5;exitX=0.512821;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.240741;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" source="chat-features_sync_supportSyncWorker_js" target="chat-X_support_service" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5020" y="1710"/><mxPoint x="8440" y="1710"/></Array></mxGeometry></mxCell><mxCell id="chat-e29" value="" style="html=1;rounded=0;jumpStyle=arc;jumpSize=8;fontSize=11;fontColor=#000000;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 3;endArrow=open;endSize=9;endFill=0;strokeColor=#1F5FBF;strokeWidth=1.5;exitX=1.0;exitY=0.666667;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.608696;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" source="chat-services_caseAccessClient_js" target="chat-X_support_service" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7490" y="2060"/><mxPoint x="7490" y="1940"/><mxPoint x="8290" y="1940"/><mxPoint x="8290" y="1880"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Support Service (Customer Service)" id="support"><mxGraphModel adaptiveColors="none" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="support-title" value="Support Service (Customer Service) – Class Diagram (ตรงกับโค้ดจริง)" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1600" height="34" as="geometry"/></mxCell><mxCell id="support-legend" value="กล่อง 1 กล่อง = 1 ไฟล์ .js (JS ไม่มี class: เป็น module ที่ export ฟังก์ชัน) หรือ 1 model ใน schema.prisma  ·  ใต้ชื่อ = ไฟล์ที่อยู่จริง&lt;br&gt;+ ชื่อ(...) = ฟังก์ชัน/ค่าที่ export  ·  ← METHOD /path = endpoint ที่เรียกฟังก์ชันนี้  ·  - prisma → X = ไฟล์นี้อ่าน/เขียน model X ผ่าน PrismaClient&lt;br&gt;เส้นประเทา ---&amp;gt; = A require B (เรียกฟังก์ชันของ B)  ·  เส้นทึบ + ตัวเลข = ความสัมพันธ์ใน Prisma (FK)  ·  ◆ = ฝังอยู่ใน document  ·  เส้นประน้ำเงิน = HTTP ข้าม service&lt;br&gt;endpoint ทั่วไปผ่าน requireAuth, /internal ผ่าน requireInternalToken (@reloop/shared)  ·  ตัด app.js, server.js, *Routes.js และ prismaClient.js ออก เพราะเป็นแค่ไฟล์ต่อสาย&lt;br&gt;Database: PostgreSQL (Prisma provider = postgresql)  ·  Csat ได้ฟังก์ชันมาจาก createCsat() ใน @reloop/shared" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="300" y="84" width="1600" height="100" as="geometry"/></mxCell><mxCell id="support-L0" value="Controller / Handler  (รับ request)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="support-L1" value="Service  (ตรรกะ)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1370" width="220" height="60" as="geometry"/></mxCell><mxCell id="support-L2" value="Model / Helper" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1870" width="220" height="60" as="geometry"/></mxCell><mxCell id="support-L3" value="Client · Realtime · Infra" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="2970" width="220" height="60" as="geometry"/></mxCell><mxCell id="support-L4" value="Prisma  (schema.prisma)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="3620" width="220" height="60" as="geometry"/></mxCell><mxCell id="support-cont" value="PrismaClient  →  schema.prisma" style="rounded=0;html=1;dashed=1;fillColor=#FBFEFB;strokeColor=#6A9F6A;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2F6B2F;" vertex="1" parent="1"><mxGeometry x="2030" y="3620" width="2960" height="1320" as="geometry"/></mxCell><mxCell id="support-features_audit_auditLog_js" value="&lt;b&gt;AuditLog&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;src/features/audit/auditLog.js&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=13;strokeWidth=1.2;fillColor=#F4F4F4;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2580" y="1870" width="480" height="120" as="geometry"/></mxCell><mxCell id="support-features_audit_auditLog_js-a" value="- prisma → TicketAuditLog" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#000000;fontSize=12;" vertex="1" parent="support-features_audit_auditLog_js"><mxGeometry y="46" width="480" height="25" as="geometry"/></mxCell