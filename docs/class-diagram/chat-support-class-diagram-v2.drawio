undColor=#ffffff;endArrow=none;strokeColor=#000000;exitX=1.0;exitY=0.642857;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.461538;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" source="chat-SupportMessageService" target="chat-Broadcast" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2350" y="350"/><mxPoint x="2350" y="380"/></Array></mxGeometry></mxCell><mxCell id="chat-e26-m0" value="1" style="edgeLabel;html=1;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" vertex="1" connectable="0" parent="chat-e26"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="12" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="chat-e26-m1" value="1" style="edgeLabel;html=1;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" vertex="1" connectable="0" parent="chat-e26"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-12" y="-10" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Support Service (Customer Service)" id="support"><mxGraphModel adaptiveColors="none" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="support-title" value="Support Service (Customer Service) – Class Diagram" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="120" y="40" width="1600" height="34" as="geometry"/></mxCell><mxCell id="support-legend" value="Domain class = ข้อมูล + method ที่ทำกับ object ตัวนั้น · Service = งานสร้าง ค้นหา ดึงรายการ ทำงานเบื้องหลัง&lt;br&gt;◆ = ส่วนประกอบ (ฝังอยู่ข้างใน) · เส้นทึบ + ตัวเลข = ความสัมพันธ์ / service ที่จัดการหรือเรียกใช้ · «value object» = กลุ่มฟิลด์ของ SupportTicket&lt;br&gt;โค้ดจริงใช้ Prisma: ข้อมูลอยู่ใน schema.prisma, method อยู่ในไฟล์ service — ชื่อจริงดูใน support-class-diagram-mapping.md" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="120" y="84" width="1600" height="64" as="geometry"/></mxCell><mxCell id="support-TicketService" value="&lt;b&gt;TicketService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=13;strokeWidth=1.2;fillColor=#E8F0FC;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1160" y="260" width="390" height="260" as="geometry"/></mxCell><mxCell id="support-TicketService-a" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#000000;fontSize=12;" vertex="1" parent="support-TicketService"><mxGeometry y="46" width="390" height="12" as="geometry"/></mxCell><mxCell id="support-TicketService-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#000000;" vertex="1" parent="support-TicketService"><mxGeometry y="58" width="390" height="8" as="geometry"/></mxCell><mxCell id="support-TicketService-m" value="+ create(requesterId: String, subject: String,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;description: String,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;category: String) : SupportTicket&lt;br&gt;+ get(ticketId: String, userId: String,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;role: String) : SupportTicket&lt;br&gt;+ listMine(requesterId: String,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;page: int