<mxfile host="app.diagrams.net"><diagram name="Chat Service" id="chat"><mxGraphModel adaptiveColors="none" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="chat-title" value="Chat Service – Class Diagram (ข้อเสนอ หลังแก้ข้อ 1+2 · ยังไม่ได้แก้โค้ด)" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1600" height="34" as="geometry"/></mxCell><mxCell id="chat-legend" value="ข้อเสนอ: Conversation เป็น class จริงในโค้ด รวมกฎของห้องไว้ที่เดียว (อยู่ในห้องไหม, ห้องล็อก, เพิ่มคน, อ่านแล้ว, เปลี่ยนสถานะ)&lt;br&gt;Service: โหลดข้อมูลผ่าน Prisma → แปลงเป็น Conversation (fromRecord) → เรียก method → บันทึกผ่าน Prisma · enum มาจาก chatEnums.js&lt;br&gt;class อื่นเป็น class ข้อมูล · เส้นทึบ + ตัวเลข = ความสัมพันธ์ / service ที่จัดการหรือเรียกใช้ · เส้นประ ---&amp;gt; = ใช้ค่า enum" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="300" y="84" width="1600" height="64" as="geometry"/></mxCell><mxCell id="chat-L0" value="Service" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="chat-L4" value="Domain" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="220" height="60" as="geometry"/></mxCell><mxCell id="chat-cont" value="Domain" style="rounded=0;html=1;dashed=1;fillColor=#FBFEFB;strokeColor=#6A9F6A;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2F6B2F;" vertex="1" parent="1"><mxGeometry x="470" y="1250" width="1940" height="1010" as="geometry"/></mxCell><mxCell id="chat-ConversationService" value="&lt;b&gt;ConversationService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;fon