2" as="offset"/></mxGeometry></mxCell><mxCell id="chat-e19" value="มีข้อความ" style="html=1;rounded=0;jumpStyle=arc;jumpSize=8;fontSize=11;fontColor=#000000;labelBackgroundColor=#ffffff;endArrow=none;strokeColor=#000000;exitX=1.0;exitY=0.6;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.558824;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" source="chat-E_Conversation" target="chat-E_Message" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1390" y="1450"/><mxPoint x="1390" y="1490"/></Array></mxGeometry></mxCell><mxCell id="chat-e19-m0" value="1" style="edgeLabel;html=1;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" vertex="1" connectable="0" parent="chat-e19"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="12" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="chat-e19-m1" value="*" style="edgeLabel;html=1;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" vertex="1" connectable="0" parent="chat-e19"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-12" y="-10" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Support Service (Customer Service)" id="support"><mxGraphModel adaptiveColors="none" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="support-title" value="Support Service (Customer Service) – Class Diagram" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1600" height="34" as="geometry"/></mxCell><mxCell id="support-legend" value="Entity = ข้อมูลใน schema.prisma (มีแค่ field เพราะในโค้ดเป็นข้อมูลที่ Prisma ส่งกลับมา)  ·  Service = ไฟล์ที่มีตรรกะ (method = ฟังก์ชันที่ export ทั้งหมด)&lt;br&gt;เส้นทึบ + ตัวเลข = ความสัมพันธ์ใน Prisma (FK)  ·  ◆ = ฝังอยู่ใน document  ·  เส้นประ ---&amp;gt; = service เรียกใช้ service / จัดการ entity หลัก&lt;br&gt;- ข้อมูลที่ใช้ → … = ตารางทั้งหมดที่ service อ่าน/เขียน (ผ่าน PrismaClient หรือไฟล์ *Model.js)  ·  ใต้ชื่อ = ไฟล์ที่อยู่จริง&lt;br&gt;ไม่ได้วาด: Controller / Route (รับส่ง HTTP แล้วเรียก service), *Model.js (repository), helper, middleware, config&lt;br&gt;Database: PostgreSQL" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="300" y="84" width="1600" height="100" as="geometry"/></mxCell><mxCell id="support-L0" value="Service  (ตรรกะ · ไฟล์ *Service.js)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="support-L4" value="Entity  (schema.prisma)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="220" height="60" as="geometry"/></mxCell><mxCell id="support-cont" value="PrismaClient  →  schema.prisma" style="rounded=0;html=1;dashed=1;fillColor=#FBFEFB;strokeColor=#6A9F6A;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2F6B2F;" vertex="1" parent="1"><mxGeometry x="240" y="1380" width="3060" height="1360" as="geometry"/></mxCell><mxCell id="support-features_tickets_ticketService_js" value="&lt;b&gt;TicketService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;src/features/tickets/ticketService.js&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=13;strokeWidth=1.2;fillColor=#E8F0FC;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="560" height="470" as="geometry"/></mxCell><mxCell id="support-features_tickets_ticketService_js-a" value="- ข้อมูลที่ใช้ → CustomerSatisfaction, SlaPolicy,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;SupportTicket, TicketAssignment, TicketAuditLog,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;TicketCategory, TicketChatLink,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;TicketChatMessageReceipt, TicketPriority,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;TicketSlaTarget, TicketStatus,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;TicketStatusHistory&lt;br&gt;- เรียก HTTP → chat-service (ห้องแชท ticket), order-service (ข้อมูล order),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;auth-service (จำนวนรายงานผู้ใช้)&lt;br&gt;«recordChatEvent, getChatAccess ถูกเรียกผ่าน /internal จาก chat-service»" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#000000;fontSize=12;" vertex="1" parent="support-features_tickets_ticketService_js"><mxGeometry y="46" width="560" height="145" as="geometry"/></mxCell><mxCell id="support-features_tickets_ticketService_js-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#000000;" vertex="1" parent="support-features_tickets_ticketService_js"><mxGeometry y="191" width="560" height="8" as="geometry"/></mxCell><mxCell id="support-features_tickets_ticketService_js-m" value="+ getDashboardMetrics({role, days})&lt;br&gt;+ takeoverTicket({ticketId, userId, role, version, reason})&lt;br&gt;+ createTicket({requesterId, subject, description, category,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;orderId, targetId})&lt;br&gt;+ getTicket({ticketId, userId, role, before, limit})&lt;br&gt;+ listMine(requesterId, pagination)&lt;br&gt;+ listQueue({role, userId, scope, work, retention, status,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;priority, search, ...pagination})&lt;br&gt;+ reply({ticketId, userId, role, body, isInternal, eventKey})&lt;br&gt;+ assignToSelf({ticketId, userId, role, version})&lt;br&gt;+ changeStatus({ticketId, userId, role, status, reason,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;version})&lt;br&gt;+ joinTicketChat({ticketId, userId, role})&lt;br&gt;+ getTicketConversation({ticketId, userId, role})&lt;br&gt;+ recordChatMessage(payload)&lt;br&gt;+ recordChatEvent(data)&lt;br&gt;+ getChatAccess({ticketId, userId, role})" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#000000;fontSize=12;" vertex="1" parent="support-features_tickets_ticketService_js"><mxGeometry y="199" width="560" height="271" as="geometry"/></mxCell><mxCell id="support-features_help_content_helpService_js" value="&lt;b&gt;HelpService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;src/features/help-content/helpService.js&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;strokeColor=#000000;font