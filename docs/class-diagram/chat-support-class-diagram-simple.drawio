aseUnreadCounts(input, db)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#000000;fontSize=12;" vertex="1" parent="chat-features_internal_internalService_js"><mxGeometry y="94" width="490" height="196" as="geometry"/></mxCell><mxCell id="chat-features_internal_supportMessageService_js" value="&lt;b&gt;SupportMessageService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;src/features/internal/supportMessageService.js&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=13;strokeWidth=1.2;fillColor=#E8F0FC;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2590" y="300" width="340" height="150" as="geometry"/></mxCell><mxCell id="chat-features_internal_supportMessageService_js-a" value="- ข้อมูลที่ใช้ → Conversation, Message&lt;br&gt;«ถูกเรียกผ่าน /internal จาก support-service»" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#000000;fontSize=12;" vertex="1" parent="chat-features_internal_supportMessageService_js"><mxGeometry y="46" width="340" height="40" as="geometry"/></mxCell><mxCell id="chat-features_internal_supportMessageService_js-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#000000;" vertex="1" parent="chat-features_internal_supportMessageService_js"><mxGeometry y="86" width="340"