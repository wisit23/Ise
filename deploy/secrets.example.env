# Copy to secrets.local.env; replace ALL placeholders before creating the Secret.
# POSTGRES_PASSWORD and PostgreSQL URL passwords must match.
# Use URL-safe passwords, or URL-encode the password in DATABASE_URL_*.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_TOKEN
DATABASE_URL_AUTH=postgresql://reloop:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/reloop_auth
DATABASE_URL_PRODUCT=postgresql://reloop:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/reloop_product
DATABASE_URL_ORDER=postgresql://reloop:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/reloop_order
DATABASE_URL_SUPPORT=postgresql://reloop:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/reloop_support
DATABASE_URL_CHAT=mongodb://mongo:27017/reloop_chat?replicaSet=rs0&directConnection=true
