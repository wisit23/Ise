# Template for root .env (Compose, production-local and production-cloud).
# Values below are development examples, NOT production credentials.
# Both production scripts reject example secrets. Use independent random values
# of at least 32 characters for POSTGRES_PASSWORD/JWT_ACCESS_SECRET/
# JWT_REFRESH_SECRET/INTERNAL_SERVICE_TOKEN; update DB URLs to match the password.
# For non-loopback access: use HTTPS APP_BASE_URL/NEXT_PUBLIC_API_URL and
# MAIL_TRANSPORT=smtp with SMTP_HOST (SMTP_USER/SMTP_PASS together if needed).
# Existing DB passwords must be rotated in the database too, not just this file.
# See deploy/production-local/README.md and deploy/production-cloud/README.md.

# Postgres
POSTGRES_USER=reloop
POSTGRES_PASSWORD=reloop_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# docker-compose.yml maps DATABASE_URL_AUTH -> DATABASE_URL inside the auth-service container
# (each service gets its own logical database this way). Running auth-service outside Compose
# requires setting DATABASE_URL directly, e.g. the same value as DATABASE_URL_AUTH below.
DATABASE_URL_AUTH=postgresql://reloop:reloop_dev_password@postgres:5432/reloop_auth
DATABASE_URL_PRODUCT=postgresql://reloop:reloop_dev_password@postgres:5432/reloop_product
DATABASE_URL_ORDER=postgresql://reloop:reloop_dev_password@postgres:5432/reloop_order
# Only needed while migrating existing review records to reloop_product:
DATABASE_URL_REVIEW=postgresql://reloop:reloop_dev_password@postgres:5432/reloop_review
DATABASE_URL_SUPPORT=postgresql://reloop:reloop_dev_password@postgres:5432/reloop_support

# Chat (CHAT-001): MongoDB, not Postgres — see docs/featureplan/chat/plan.md for why.
# directConnection=true is required for a single-node replica set: without it
# the driver tries SRV-style topology discovery that a one-node rs0 doesn't
# support, and connections fail.
DATABASE_URL_CHAT=mongodb://mongo:27017/reloop_chat?replicaSet=rs0&directConnection=true

# Redis
REDIS_URL=redis://redis:6379

# Auth
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Forgot-password email (auth-service). MAIL_TRANSPORT is one of:
#   log      - print the email (with the live reset link) to the auth-service log.
#              Local development only: refused unless APP_BASE_URL is localhost.
#   smtp     - send through SMTP_*; required on any shared or public server.
#   disabled - the default when unset; the reset endpoints answer 503.
# APP_BASE_URL is the site origin the emailed link points at (https outside localhost).
MAIL_TRANSPORT=log
APP_BASE_URL=http://localhost:3000
MAIL_FROM="RE-LOOP <no-reply@localhost>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587              # 587 = STARTTLS (enforced), 465 = implicit TLS
# SMTP_SECURE=false          # defaults to true only for port 465
# SMTP_USER=your-sender@gmail.com
# SMTP_PASS=your-16-character-app-password
# Optional tuning (defaults shown)
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# PASSWORD_RESET_RETENTION_DAYS=30
# PASSWORD_RESET_WINDOW_SECONDS=3600
# PASSWORD_RESET_EMAIL_LIMIT=3
# PASSWORD_RESET_IP_LIMIT=10
# PASSWORD_RESET_SUBMIT_WINDOW_SECONDS=900
# PASSWORD_RESET_SUBMIT_IP_LIMIT=20
# Sign-up email confirmation: required | off. Defaults to "required" whenever
# MAIL_TRANSPORT can send, "off" otherwise. While required, new accounts must
# open the emailed link before they can sign in. Accounts created before the
# feature shipped were marked verified by its migration.
# EMAIL_VERIFICATION=required
# EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
# EMAIL_VERIFICATION_RETENTION_DAYS=30
# EMAIL_VERIFICATION_WINDOW_SECONDS=3600
# EMAIL_VERIFICATION_EMAIL_LIMIT=3
# EMAIL_VERIFICATION_IP_LIMIT=10
# EMAIL_VERIFICATION_SUBMIT_WINDOW_SECONDS=900
# EMAIL_VERIFICATION_SUBMIT_IP_LIMIT=20
# Proxies auth-service trusts for X-Forwarded-For (Express "trust proxy").
# Default: loopback, linklocal, uniquelocal (the Docker/k8s private networks).
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Internal service-to-service token (product lock/unlock/sold endpoints)
INTERNAL_SERVICE_TOKEN=dev_internal_token_change_me

# Host ports: production-local/cloud publish only frontend and gateway.
# Kubernetes internal ports stay fixed (frontend 3000, gateway 8080).
# When changing these host ports, update the localhost URLs too; API URL needs rebuild.
# Other service *_PORT values below are used by Compose; Kubernetes keeps them internal.
GATEWAY_PORT=8080
AUTH_PORT=3001
PRODUCT_PORT=3002
ORDER_PORT=3003
CHAT_PORT=3004
SUPPORT_PORT=3006
FRONTEND_PORT=3000

NEXT_PUBLIC_API_URL=http://localhost:8080

# Customer Service configuration (JSON paths must exist in each backend container)
# CS_POLICY_FILE=/app/shared/config/customer-service-policy-custom.json
# CS_CLIENT_CONFIG_FILE=/app/shared/config/customer-service-client-custom.json
# Optional editorial setup: create initial FAQ articles only when explicitly enabled
# CS_SEED_HELP_CONTENT=1
CS_DEPENDENCY_TIMEOUT_MS=3000
CS_CHAT_TIMEOUT_MS=5000
CS_SLA_MONITOR_INTERVAL_MS=60000
CS_TRANSACTION_ATTEMPTS=3
CS_SYNC_POLL_INTERVAL_MS=5000
CS_SYNC_INITIAL_BACKOFF_MS=1000
CS_SYNC_MAX_BACKOFF_MS=60000
# Chat budgets and windows can be overridden independently
# CHAT_RATE_LIMIT_SEND_MESSAGE=30
# CHAT_RATE_WINDOW_SEND_MESSAGE=10
# CHAT_RATE_LIMIT_UPLOAD_ATTACHMENT=10
# CHAT_RATE_WINDOW_UPLOAD_ATTACHMENT=60
# CHAT_RATE_LIMIT_CREATE_CONVERSATION=20
# CHAT_RATE_WINDOW_CREATE_CONVERSATION=60
# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
# Executive complaint configuration (validated by auth-service)
EXECUTIVE_REPORT_DEFAULT_LIMIT=50
EXECUTIVE_REPORT_MAX_LIMIT=100
EXECUTIVE_REPORT_ANOMALY_THRESHOLD=3
NEXT_PUBLIC_REPORT_TIMEZONE=Asia/Bangkok
NEXT_PUBLIC_REPORT_SEARCH_DEBOUNCE_MS=300
NEXT_PUBLIC_REPORT_REQUEST_TIMEOUT_MS=10000

# Platform fee as a fraction of GMV (0.03 = 3%). Owned by order-service; the dashboard reads it from the API.
PLATFORM_FEE_RATE=0.03
